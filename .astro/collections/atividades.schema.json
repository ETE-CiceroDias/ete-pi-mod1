{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "tipo": {
      "default": "exercicio",
      "type": "string",
      "enum": [
        "exercicio",
        "desafio",
        "projeto",
        "quiz"
      ]
    },
    "aulaRef": {
      "type": "string"
    },
    "subtitulo": {
      "type": "string"
    },
    "duracao": {
      "type": "string"
    },
    "nivel": {
      "default": "basico",
      "type": "string",
      "enum": [
        "basico",
        "intermediario",
        "avancado"
      ]
    },
    "entrega": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "default": "aberta",
      "type": "string",
      "enum": [
        "aberta",
        "em-breve",
        "encerrada"
      ]
    },
    "topicos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "aulaRef",
    "subtitulo"
  ]
}