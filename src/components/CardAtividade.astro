---
// Usado dentro de uma aula para referenciar uma atividade
// Uso: <CardAtividade slug="ex-html-parte1" />
import { getCollection } from 'astro:content'
const { slug } = Astro.props

const todas = await getCollection('atividades')
const at = todas.find(a => a.id === slug)

const tipoLabel: Record<string, string> = {
  exercicio: 'Exercício',
  desafio:   'Desafio',
  projeto:   'Projeto',
  quiz:      'Quiz',
}
const nivelColor: Record<string, string> = {
  basico:        'rgba(124,74,224,.9)',
  intermediario: '#f59e0b',
  avancado:      '#f87171',
}
---
{at ? (
  <a href={`/atividades/${at.id}`} class="card-at-link">
    <div class="card-at">
      <div class="card-at-left">
        <span class="card-at-tipo">{tipoLabel[at.data.tipo] ?? at.data.tipo}</span>
        <div class="card-at-titulo">{at.data.titulo}</div>
        <div class="card-at-sub">{at.data.subtitulo}</div>
        <div class="card-at-meta">
          {at.data.duracao && <span class="card-at-chip">{at.data.duracao}</span>}
          <span class="card-at-chip" style={`color:${nivelColor[at.data.nivel]};border-color:${nivelColor[at.data.nivel]}44`}>
            {at.data.nivel}
          </span>
        </div>
      </div>
      <div class="card-at-arrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M17 7H7M17 7v10"/></svg>
      </div>
    </div>
  </a>
) : (
  <div class="card-at card-at-missing">
    Atividade <code>{slug}</code> não encontrada.
  </div>
)}

<style>
  .card-at-link { text-decoration: none; color: inherit; display: block; }
  .card-at {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    background: var(--card); border: 1.5px solid var(--glass-b);
    border-radius: 16px; padding: 1.3rem 1.5rem; margin: 1.5rem 0;
    transition: border-color var(--t), box-shadow var(--t), transform var(--t);
    position: relative; overflow: hidden;
  }
  .card-at::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(124,74,224,.06), transparent);
    pointer-events: none;
  }
  .card-at-link:hover .card-at {
    border-color: var(--primary-h);
    box-shadow: 0 8px 30px rgba(124,74,224,.18);
    transform: translateY(-2px);
  }
  .card-at-left { flex: 1; min-width: 0; }
  .card-at-tipo {
    font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    color: var(--primary); margin-bottom: .4rem; display: block;
  }
  .card-at-titulo {
    font-family: var(--font-h); font-size: 1.3rem; font-weight: 300;
    line-height: 1.2; margin-bottom: .3rem; color: var(--text);
  }
  .card-at-sub { font-size: .83rem; color: var(--text-2); line-height: 1.55; margin-bottom: .7rem; }
  .card-at-meta { display: flex; align-items: center; gap: .5rem; }
  .card-at-chip {
    font-size: .68rem; font-weight: 600; padding: .18rem .6rem;
    border: 1px solid var(--border); border-radius: 99px; color: var(--text-3);
  }
  .card-at-arrow { color: var(--text-3); flex-shrink: 0; transition: transform var(--t), color var(--t); }
  .card-at-link:hover .card-at-arrow { transform: translate(3px,-3px); color: var(--primary); }
  .card-at-missing { border-style: dashed; font-size: .85rem; color: var(--text-3); }
</style>
