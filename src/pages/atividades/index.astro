---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'

const atividades = await getCollection('atividades')
const sorted = atividades.sort((a,b) => a.data.titulo.localeCompare(b.data.titulo))

const tipoLabel: Record<string,string> = { exercicio:'Exercício', desafio:'Desafio', projeto:'Projeto', quiz:'Quiz' }
---
<Base title="Atividades · ETE Cícero Dias" description="Exercícios, desafios e projetos de PI I.">
  <section class="hero" style="min-height:50vh;">
    <div class="blob blob-1"></div><div class="blob blob-2"></div>
    <div class="hero-inner">
      <div class="hero-badge"><span class="bdot"></span>PI I · 2026</div>
      <h1 class="hero-title">Atividades e <em>Desafios</em></h1>
      <p class="hero-sub">Exercícios práticos, desafios e projetos de cada aula.</p>
    </div>
  </section>
  <section class="section">
    <div class="section-inner">
      <div class="section-header reveal">
        <div class="section-label">Todas as atividades</div>
        <h2 class="section-title">{sorted.length} <em>atividades</em></h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        {sorted.map(at => (
          <a href={`/atividades/${at.id}`} class="at-list-item reveal">
            <div>
              <span class="at-list-tipo">{tipoLabel[at.data.tipo] ?? at.data.tipo}</span>
              <div class="at-list-titulo">{at.data.titulo}</div>
              <div class="at-list-sub">{at.data.subtitulo}</div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M17 7H7M17 7v10"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .at-list-item{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 1.4rem;background:var(--card);border:1px solid var(--border);border-radius:14px;color:inherit;text-decoration:none;transition:border-color var(--t),transform var(--t);}
  .at-list-item:hover{border-color:var(--primary-h);transform:translateX(4px);}
  .at-list-tipo{font-size:.6rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--primary);display:block;margin-bottom:.25rem;}
  .at-list-titulo{font-family:var(--font-h);font-size:1.2rem;font-weight:300;margin-bottom:.2rem;}
  .at-list-sub{font-size:.82rem;color:var(--text-2);}
</style>
