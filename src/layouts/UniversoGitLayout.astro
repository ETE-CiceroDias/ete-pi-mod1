---
import '../styles/global.css'
---
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Universo Git · ETE Cícero Dias</title>
  <meta name="description" content="Versionamento de código, colaboração e boas práticas com Git e GitHub."/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    html{scroll-behavior:smooth;}

    :root {
      --git-bg:      #07050f;
      --git-surface: #0f0b1f;
      --git-card:    #130e26;
      --git-border:  rgba(124,74,224,0.18);
      --git-border-h:rgba(124,74,224,0.55);
      --git-acc:     #7c4ae0;
      --git-acc-dim: rgba(124,74,224,0.12);
      --git-text:    #eae6ff;
      --git-text-sub:rgba(234,230,255,0.6);
      --git-text-dim:rgba(234,230,255,0.35);
      --git-mono:    'JetBrains Mono', 'Courier New', monospace;
      --font-h:      'Cormorant Garamond', Georgia, serif;
      --font-b:      'Plus Jakarta Sans', sans-serif;
    }

    body { background: var(--git-bg); color: var(--git-text); font-family: var(--font-b); overflow-x: hidden; }
    a { text-decoration: none; color: inherit; }
    ::selection { background: var(--git-acc); color: #fff; }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--git-bg); }
    ::-webkit-scrollbar-thumb { background: var(--git-acc); border-radius: 99px; }

    /* PROGRESS */
    #prog { position:fixed; top:0; left:0; height:2px; z-index:600; background:linear-gradient(135deg,#7c4ae0,#532d9f); width:0; transition:width .1s; }

    /* BTT */
    #btt { position:fixed; bottom:2rem; right:2rem; z-index:500; width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,#7c4ae0,#532d9f); color:#fff; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 30px rgba(0,0,0,.6); opacity:0; transform:translateY(16px) scale(.85); transition:opacity .3s,transform .3s; pointer-events:none; }
    #btt.show { opacity:1; transform:translateY(0) scale(1); pointer-events:all; }
    #btt:hover { transform:translateY(-3px) scale(1.08); }

    /* NAV */
    .nav { position:fixed; top:0; left:0; right:0; z-index:400; display:flex; align-items:center; justify-content:space-between; padding:.85rem 2.5rem; background:rgba(7,5,15,.92); backdrop-filter:blur(18px); border-bottom:1px solid rgba(124,74,224,.12); transition:box-shadow .22s; }
    .nav.scrolled { box-shadow:0 6px 20px rgba(0,0,0,.4); }
    .nav-back { display:inline-flex; align-items:center; gap:.5rem; font-size:.8rem; font-weight:600; color:rgba(234,230,255,.5); transition:color .2s; }
    .nav-back:hover { color:var(--git-text); }
    .nav-back svg { width:15px; height:15px; }
    .nav-center { display:flex; align-items:center; }
    .nav-tag-git { display:inline-flex; align-items:center; gap:.4rem; padding:.3rem .8rem; border:1px solid var(--git-border); border-radius:99px; font-size:.7rem; font-weight:700; color:rgba(184,154,255,.8); letter-spacing:.06em; text-transform:uppercase; }
    .nav-tag-git svg { width:12px; height:12px; }
    .nav-aula-info { font-size:.75rem; color:var(--git-text-dim); font-weight:500; }

    /* HERO */
    .hero-git { min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:7rem 2rem 4rem; position:relative; overflow:hidden; text-align:center; }
    .git-blob { position:absolute; pointer-events:none; filter:blur(90px); z-index:0; border-radius:50%; }
    .git-blob-1 { width:500px; height:350px; background:radial-gradient(circle,rgba(124,74,224,.22) 0%,transparent 70%); top:-5%; left:0%; animation:gbd1 22s ease-in-out infinite; }
    .git-blob-2 { width:380px; height:480px; background:radial-gradient(circle,rgba(193,77,216,.15) 0%,transparent 70%); top:20%; right:-5%; animation:gbd2 28s ease-in-out infinite; }
    .git-blob-3 { width:300px; height:300px; background:radial-gradient(circle,rgba(67,233,123,.07) 0%,transparent 70%); bottom:10%; left:20%; animation:gbd3 18s ease-in-out infinite; }
    @keyframes gbd1{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(30px,-20px) scale(1.05);}}
    @keyframes gbd2{0%,100%{transform:translate(0,0);}50%{transform:translate(-25px,30px) scale(.95);}}
    @keyframes gbd3{0%,100%{transform:translate(0,0);}50%{transform:translate(20px,-25px) scale(1.07);}}

    .hero-git-inner { position:relative; z-index:2; max-width:680px; display:flex; flex-direction:column; align-items:center; gap:1.2rem; }
    .hero-git-badge { display:inline-flex; align-items:center; gap:.5rem; padding:.38rem 1rem; background:rgba(124,74,224,.12); border:1px solid rgba(124,74,224,.3); border-radius:99px; font-size:.7rem; font-weight:700; color:#b89aff; letter-spacing:.08em; text-transform:uppercase; }
    .bdot { width:6px; height:6px; border-radius:50%; background:#b89aff; animation:pulse 2s ease-in-out infinite; }
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(1.5);}}
    .hero-git-title { font-family:var(--font-h); font-size:clamp(2.8rem,7vw,5rem); font-weight:300; letter-spacing:-.04em; line-height:1; color:var(--git-text); }
    .hero-git-title em { font-style:italic; color:#b89aff; font-weight:200; }
    .hero-git-sub { font-size:clamp(.88rem,2vw,1rem); color:var(--git-text-sub); line-height:1.75; max-width:480px; }
    .hero-scroll { position:absolute; bottom:1.5rem; left:50%; transform:translateX(-50%); color:var(--git-text-dim); animation:bounce 2s ease-in-out infinite; z-index:3; }
    @keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(8px);}}

    /* TERMINAL HERO */
    .hero-terminal { width:100%; max-width:500px; background:#050309; border:1px solid rgba(124,74,224,.35); border-radius:12px; overflow:hidden; box-shadow:0 8px 40px rgba(0,0,0,.5),0 0 0 1px rgba(124,74,224,.1); font-family:var(--git-mono); text-align:left; }
    .term-bar { display:flex; align-items:center; gap:6px; padding:10px 14px; background:rgba(255,255,255,.04); border-bottom:1px solid rgba(124,74,224,.15); }
    .term-dot { width:10px; height:10px; border-radius:50%; }
    .term-red { background:#ff5f57; } .term-yellow { background:#febc2e; } .term-green { background:#28c840; }
    .term-title { margin-left:6px; font-size:11px; color:rgba(234,230,255,.3); letter-spacing:.04em; }
    .term-body { padding:16px 18px; display:flex; flex-direction:column; gap:4px; min-height:120px; }
    .term-line { display:flex; align-items:center; font-size:13px; line-height:1.6; }
    .term-prompt { color:#7c4ae0; font-weight:500; user-select:none; }
    .term-cmd { color:#eae6ff; font-size:13px; }
    .term-out { font-size:12px; color:rgba(234,230,255,.45); padding-left:16px; line-height:1.6; margin-bottom:4px; }
    .term-acc { color:#7c4ae0; }
    .term-cursor { display:inline-block; width:8px; height:14px; background:#7c4ae0; margin-left:1px; animation:blink 1.1s step-end infinite; vertical-align:middle; }
    @keyframes blink{0%,100%{opacity:0}50%{opacity:1}}
    .term-cursor-line { display:flex; align-items:center; }

    /* SECTION */
    .section { padding:5rem 0; }
    .section-inner { max-width:1100px; margin:0 auto; padding:0 2rem; }
    .section-label { font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#b89aff; margin-bottom:.7rem; display:flex; align-items:center; gap:.5rem; }
    .section-label::before { content:''; width:18px; height:2px; background:linear-gradient(135deg,#7c4ae0,#c14dd8); border-radius:99px; }
    .section-title { font-family:var(--font-h); font-size:clamp(2rem,4vw,3rem); font-weight:300; letter-spacing:-.02em; margin-bottom:.9rem; line-height:1.1; color:var(--git-text); }
    .section-title em { font-style:italic; color:#b89aff; font-weight:200; }
    .section-header { margin-bottom:3rem; }

    /* GRID */
    .aulas-git-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1.2rem; }
    .aula-git-card { background:var(--git-card); border:1px solid var(--git-border); border-radius:16px; overflow:hidden; display:flex; flex-direction:column; text-decoration:none; color:inherit; transition:transform .22s,box-shadow .22s,border-color .22s; position:relative; }
    .aula-git-card:not(.em-breve):hover { transform:translateY(-5px); box-shadow:0 16px 50px rgba(124,74,224,.25); border-color:var(--git-border-h); }
    .aula-git-card.em-breve { opacity:.45; pointer-events:none; }
    .agc-num { position:absolute; top:12px; right:16px; font-family:var(--font-h); font-size:5rem; font-weight:700; color:rgba(124,74,224,.07); line-height:1; user-select:none; pointer-events:none; }
    .agc-body { padding:1.4rem 1.4rem 1rem; flex:1; position:relative; z-index:1; }
    .agc-header { margin-bottom:.8rem; }
    .agc-badge-ok, .agc-badge-soon { display:inline-flex; align-items:center; gap:.35rem; padding:.2rem .65rem; border-radius:99px; font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; }
    .agc-badge-ok { background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.25); }
    .agc-badge-ok .status-dot { background:#10b981; animation:pulse 2s ease-in-out infinite; }
    .agc-badge-soon { background:rgba(124,74,224,.1); color:#b89aff; border:1px solid rgba(124,74,224,.2); }
    .agc-badge-soon .status-dot { background:#b89aff; }
    .status-dot { width:5px; height:5px; border-radius:50%; background:currentColor; }
    .agc-title { font-family:var(--font-h); font-size:1.35rem; font-weight:300; line-height:1.2; margin-bottom:.5rem; color:var(--git-text); }
    .agc-title em { font-style:italic; color:#b89aff; }
    .agc-desc { font-size:.8rem; color:var(--git-text-sub); line-height:1.6; margin-bottom:.9rem; }
    .agc-topics { display:flex; flex-wrap:wrap; gap:.35rem; }
    .agc-tag { font-family:var(--git-mono); padding:.15rem .5rem; background:rgba(124,74,224,.1); border:1px solid rgba(124,74,224,.22); border-radius:4px; font-size:.65rem; color:rgba(184,154,255,.7); }
    .agc-footer { padding:.8rem 1.4rem; border-top:1px solid rgba(124,74,224,.12); display:flex; align-items:center; justify-content:space-between; }
    .agc-meta { display:flex; align-items:center; gap:.35rem; font-size:.72rem; color:var(--git-text-dim); font-weight:500; }
    .agc-meta svg { width:13px; height:13px; }
    .agc-arrow { color:var(--git-text-dim); transition:transform .22s,color .22s; display:flex; }
    .aula-git-card:hover .agc-arrow { transform:translate(3px,-3px); color:#b89aff; }

    /* FOOTER */
    .footer-git { padding:2rem 2.5rem; border-top:1px solid var(--git-border); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; }
    .footer-logo { font-family:var(--font-h); font-size:1.2rem; font-weight:300; letter-spacing:-.02em; color:var(--git-text); }
    .footer-logo em { font-style:italic; color:#b89aff; }
    .footer-sub { font-size:.7rem; color:var(--git-text-dim); margin-top:.1rem; }
    .footer-right { font-size:.78rem; color:var(--git-text-dim); }

    /* REVEAL */
    .reveal { opacity:0; transform:translateY(24px); transition:opacity .6s ease,transform .6s ease; }
    .reveal.vis { opacity:1; transform:translateY(0); }
    .reveal-d1{transition-delay:.1s;} .reveal-d2{transition-delay:.2s;} .reveal-d3{transition-delay:.3s;}

    @media(max-width:600px){
      .nav{padding:.85rem 1.25rem;}
      .nav-aula-info{display:none;}
      .hero-git{padding:6rem 1.25rem 3rem;}
      .aulas-git-grid{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>
  <div id="prog"></div>

  <nav class="nav" id="nav">
    <a href="/" class="nav-back">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      Todas as aulas
    </a>
    <div class="nav-center">
      <span class="nav-tag-git">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/></svg>
        Universo Git
      </span>
    </div>
    <div>
      <span class="nav-aula-info">PI I · Mod. 1 · 2026</span>
    </div>
  </nav>

  <button id="btt" onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
  </button>

  <!-- HERO -->
  <section class="hero-git" id="hero">
    <div class="git-blob git-blob-1"></div>
    <div class="git-blob git-blob-2"></div>
    <div class="git-blob git-blob-3"></div>

    <div class="hero-git-inner">
      <div class="hero-git-badge">
        <span class="bdot"></span>
        Trilha de aulas · Git &amp; GitHub
      </div>

      <h1 class="hero-git-title">Universo <em>Git</em></h1>
      <p class="hero-git-sub">Versionamento de código, colaboração e boas práticas com Git &amp; GitHub. Aprenda a trabalhar como dev de verdade.</p>

      <div class="hero-terminal">
        <div class="term-bar">
          <span class="term-dot term-red"></span>
          <span class="term-dot term-yellow"></span>
          <span class="term-dot term-green"></span>
          <span class="term-title">bash — ~/meu-projeto</span>
        </div>
        <div class="term-body">
          <div class="term-line"><span class="term-prompt">$ </span><span class="term-cmd typed" id="t1"></span></div>
          <div class="term-out" id="out1" style="display:none">Initialized empty Git repository in ~/meu-projeto/.git/</div>
          <div class="term-line" id="line2" style="display:none"><span class="term-prompt">$ </span><span class="term-cmd" id="t2"></span></div>
          <div class="term-out" id="out2" style="display:none">On branch <span class="term-acc">main</span><br>No commits yet — <span class="term-acc">nothing to commit</span></div>
          <div class="term-line" id="line3" style="display:none"><span class="term-prompt">$ </span><span class="term-cursor-line"><span class="term-cursor"></span></span></div>
        </div>
      </div>
    </div>

    <div class="hero-scroll">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </section>

  <!-- TRILHA -->
  <section class="section" id="trilha">
    <div class="section-inner">
      <div class="section-header reveal">
        <div class="section-label">Conteúdo</div>
        <h2 class="section-title">Aulas da <em>trilha</em></h2>
      </div>
      <div class="aulas-git-grid">

        <!-- 01 — publicada -->
        <a href="/universo-git/git-01" class="aula-git-card reveal">
          <div class="agc-num">01</div>
          <div class="agc-body">
            <div class="agc-header">
              <div class="agc-badge-ok"><span class="status-dot"></span>Publicada</div>
            </div>
            <div class="agc-title">Introdução ao <em>Git &amp; GitHub</em></div>
            <div class="agc-desc">O que é versionamento, por que usar, diferença entre Git e GitHub, e os primeiros comandos no terminal.</div>
            <div class="agc-topics">
              <span class="agc-tag">git init</span>
              <span class="agc-tag">git status</span>
              <span class="agc-tag">git add</span>
              <span class="agc-tag">git commit</span>
            </div>
          </div>
          <div class="agc-footer">
            <div class="agc-meta">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              abr 2026
            </div>
            <div class="agc-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M17 7H7M17 7v10"/></svg>
            </div>
          </div>
        </a>

        <!-- 02 — em breve -->
        <div class="aula-git-card em-breve reveal reveal-d1">
          <div class="agc-num">02</div>
          <div class="agc-body">
            <div class="agc-header"><div class="agc-badge-soon"><span class="status-dot"></span>Em breve</div></div>
            <div class="agc-title">Branches e <em>Merge</em></div>
            <div class="agc-desc">Como criar ramificações para trabalhar em funcionalidades sem quebrar o código principal.</div>
            <div class="agc-topics"><span class="agc-tag">git branch</span><span class="agc-tag">git checkout</span><span class="agc-tag">git merge</span></div>
          </div>
          <div class="agc-footer"><div class="agc-meta">Em breve</div></div>
        </div>

        <!-- 03 — em breve -->
        <div class="aula-git-card em-breve reveal reveal-d2">
          <div class="agc-num">03</div>
          <div class="agc-body">
            <div class="agc-header"><div class="agc-badge-soon"><span class="status-dot"></span>Em breve</div></div>
            <div class="agc-title">GitHub na <em>prática</em></div>
            <div class="agc-desc">Criar repositório remoto, conectar com o local, push, pull e trabalhar em equipe com GitHub.</div>
            <div class="agc-topics"><span class="agc-tag">git remote</span><span class="agc-tag">git push</span><span class="agc-tag">git pull</span><span class="agc-tag">GitHub</span></div>
          </div>
          <div class="agc-footer"><div class="agc-meta">Em breve</div></div>
        </div>

        <!-- 04 — em breve -->
        <div class="aula-git-card em-breve reveal reveal-d3">
          <div class="agc-num">04</div>
          <div class="agc-body">
            <div class="agc-header"><div class="agc-badge-soon"><span class="status-dot"></span>Em breve</div></div>
            <div class="agc-title">Conventional <em>Commits</em></div>
            <div class="agc-desc">Escrever mensagens de commit que fazem sentido — padrão profissional que o mercado usa.</div>
            <div class="agc-topics"><span class="agc-tag">feat:</span><span class="agc-tag">fix:</span><span class="agc-tag">chore:</span><span class="agc-tag">docs:</span></div>
          </div>
          <div class="agc-footer"><div class="agc-meta">Em breve</div></div>
        </div>

      </div>
    </div>
  </section>

  <footer class="footer-git">
    <div>
      <div class="footer-logo">ETE <em>Cícero Dias</em></div>
      <div class="footer-sub">Desenvolvimento de Sistemas · Módulo 1 · 2026</div>
    </div>
    <div class="footer-right">Universo Git · Prof.ª Samara Sabino</div>
  </footer>

  <script is:inline>
    const prog=document.getElementById('prog'),nav=document.getElementById('nav'),btt=document.getElementById('btt');
    window.addEventListener('scroll',()=>{
      prog.style.width=(scrollY/(document.body.scrollHeight-innerHeight)*100)+'%';
      nav.classList.toggle('scrolled',scrollY>60);
      btt.classList.toggle('show',scrollY>400);
    });
    const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('vis');}),{threshold:.1});
    document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

    function typeText(el,text,delay,cb){
      el.textContent='';let i=0;
      setTimeout(()=>{
        const t=setInterval(()=>{
          el.textContent+=text[i++];
          if(i>=text.length){clearInterval(t);if(cb)cb();}
        },55);
      },delay);
    }
    window.addEventListener('load',()=>{
      const t1=document.getElementById('t1'),out1=document.getElementById('out1');
      const line2=document.getElementById('line2'),t2=document.getElementById('t2'),out2=document.getElementById('out2');
      const line3=document.getElementById('line3');
      typeText(t1,'git init',400,()=>{
        out1.style.display='';
        line2.style.display='';
        typeText(t2,'git status',1200,()=>{
          out2.style.display='';
          line3.style.display='';
        });
      });
    });
  </script>
</body>
</html>
