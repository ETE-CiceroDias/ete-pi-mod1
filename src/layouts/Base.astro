---
import '../styles/global.css'
const { title = 'ETE Cícero Dias', description = 'Material de aulas — ETE Cícero Dias' } = Astro.props
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Prof.ª Samara Sabino" />
  <meta name="theme-color" content="#7c4ae0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" is:inline></script>
</head>
<body>
  <div id="prog"></div>

  <nav class="nav" id="nav">
    <a href="/" class="nav-logo">ETE <em>Cícero Dias</em></a>
    <div class="nav-right">
      <span class="nav-tag">PI I · Mod. 1</span>
      <button class="theme-toggle" id="themeToggle" aria-label="Alternar tema">
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </nav>

  <button id="btt" aria-label="Voltar ao topo">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 15-6-6-6 6"/></svg>
  </button>

  <slot />

  <footer class="footer">
    <div>
      <div class="footer-logo">ETE <em>Cícero Dias</em></div>
      <div class="footer-sub">Prof.ª Samara Sabino · Projeto Integrador I · 2026</div>
    </div>
    <div class="footer-right">Módulo 1 · Desenvolvimento de Sistemas</div>
  </footer>

  <script is:inline>
    // ── Theme ──────────────────────────────────────
    const root = document.documentElement
    const btn  = document.getElementById('themeToggle')
    const sun  = document.getElementById('icon-sun')
    const moon = document.getElementById('icon-moon')

    const saved = localStorage.getItem('theme') || 'light'
    applyTheme(saved)

    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
      applyTheme(next)
      localStorage.setItem('theme', next)
    })

    function applyTheme(t) {
      root.dataset.theme = t
      sun.style.display  = t === 'dark'  ? 'block' : 'none'
      moon.style.display = t === 'light' ? 'block' : 'none'
    }

    // ── Nav scroll ─────────────────────────────────
    const nav = document.getElementById('nav')
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40))

    // ── Progress bar ───────────────────────────────
    const prog = document.getElementById('prog')
    window.addEventListener('scroll', () => {
      const pct = scrollY / (document.body.scrollHeight - innerHeight) * 100
      prog.style.width = pct + '%'
    })

    // ── Back to top ────────────────────────────────
    const btt = document.getElementById('btt')
    window.addEventListener('scroll', () => btt.classList.toggle('show', scrollY > 300))
    btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))

    // ── Scroll reveal ──────────────────────────────
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('vis'); obs.unobserve(e.target) } })
    }, { threshold: 0.1 })
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el))

    // ── Lucide icons ───────────────────────────────
    if (typeof lucide !== 'undefined') lucide.createIcons()
  </script>
</body>
</html>
