---
import Base from './Base.astro'
const { at } = Astro.props
const { titulo, subtitulo, tipo, aulaRef, duracao, nivel, entrega, status, topicos } = at

const tipoLabel: Record<string, string> = {
  exercicio: 'Exercício',
  desafio:   'Desafio',
  projeto:   'Projeto',
  quiz:      'Quiz',
}
const nivelColor: Record<string, string> = {
  basico:        'var(--primary)',
  intermediario: '#f59e0b',
  avancado:      '#f87171',
}
const tipoIcon: Record<string, string> = {
  exercicio: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 0 2-2h2a2 2 0 0 0 2 2',
  desafio:   'M13 10V3L4 14h7v7l9-11h-7z',
  projeto:   'M3 7h18M3 12h18M3 17h18',
  quiz:      'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
}
---
<Base title={`${tipoLabel[tipo] ?? tipo}: ${titulo} · ETE Cícero Dias`} description={subtitulo}>

  <div style="margin-top:3.5rem;">
    <!-- HERO ATIVIDADE -->
    <div class="at-hero">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="at-hero-inner">

        <div style="margin-bottom:1.2rem;">
          <a href={`/aulas/${aulaRef}`} class="nav-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            Voltar para a aula
          </a>
        </div>

        <div class="at-tipo-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d={tipoIcon[tipo] ?? tipoIcon.exercicio}/>
          </svg>
          {tipoLabel[tipo] ?? tipo}
        </div>

        <h1 class="at-title">{titulo}</h1>
        <p class="at-sub">{subtitulo}</p>

        <div class="at-meta">
          <span class="at-chip" style={`border-color:${nivelColor[nivel]};color:${nivelColor[nivel]}`}>
            {nivel}
          </span>
          {duracao && <span class="at-chip">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
            {duracao}
          </span>}
          {entrega && <span class="at-chip">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Entrega: {entrega}
          </span>}
          <span class={`at-chip ${status === 'encerrada' ? 'at-encerrada' : status === 'em-breve' ? 'at-embreve' : 'at-aberta'}`}>
            <span class="status-dot"></span>
            {status === 'aberta' ? 'Aberta' : status === 'em-breve' ? 'Em breve' : 'Encerrada'}
          </span>
        </div>

        {topicos.length > 0 && (
          <div class="at-topics">
            {topicos.map((t: string) => <span class="topic-tag">{t}</span>)}
          </div>
        )}

      </div>
    </div>
  </div>

  <!-- CONTEÚDO -->
  <div class="aula-layout">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-title">Nesta atividade</div>
      <nav class="sidebar-nav" id="sidebarNav"></nav>
      <div class="sidebar-sep"></div>
      <a href={`/aulas/${aulaRef}`} class="sidebar-item">
        <span class="si-dot"></span>
        Voltar para a aula
      </a>
    </aside>
    <div class="aula-prose prose" id="aulaConteudo">
      <slot/>
    </div>
  </div>

</Base>

<style>
  .at-hero {
    position: relative; overflow: hidden;
    padding: 6rem 2.5rem 3rem;
    border-bottom: 1px solid var(--border);
  }
  .at-hero-inner { position: relative; z-index: 2; max-width: 760px; }
  .at-tipo-badge {
    display: inline-flex; align-items: center; gap: .45rem;
    padding: .3rem .9rem; background: var(--glass); border: 1px solid var(--glass-b);
    border-radius: 99px; font-size: .68rem; font-weight: 700; color: var(--primary);
    margin-bottom: 1rem; letter-spacing: .08em; text-transform: uppercase;
  }
  .at-title {
    font-family: var(--font-h); font-size: clamp(2rem,4.5vw,3.2rem);
    font-weight: 300; line-height: 1.1; letter-spacing: -.03em; margin-bottom: .6rem;
  }
  .at-sub { font-size: 1rem; color: var(--text-2); line-height: 1.75; max-width: 560px; margin-bottom: 1.4rem; }
  .at-meta { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .at-chip {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .25rem .7rem; border: 1px solid var(--border);
    border-radius: 99px; font-size: .7rem; font-weight: 600; color: var(--text-3);
  }
  .at-aberta   { border-color: rgba(16,185,129,.3); color: #34d399; }
  .at-embreve  { border-color: rgba(124,74,224,.3); color: var(--primary); }
  .at-encerrada{ border-color: rgba(239,68,68,.3);  color: #f87171; }
  .at-aberta .status-dot   { background: #34d399; animation: pulse 2s ease-in-out infinite; }
  .at-embreve .status-dot  { background: var(--primary); }
  .at-encerrada .status-dot{ background: #f87171; }
  .at-topics { display: flex; flex-wrap: wrap; gap: .4rem; }
</style>

<script is:inline>
  (function(){
    const nav=document.getElementById('sidebarNav'),prose=document.getElementById('aulaConteudo');
    if(!nav||!prose)return;
    const hs=prose.querySelectorAll('h2');
    hs.forEach((h,i)=>{if(!h.id)h.id='sec-'+i;const a=document.createElement('a');a.className='sidebar-item';a.href='#'+h.id;a.innerHTML='<span class="si-dot"></span>'+h.textContent;a.addEventListener('click',e=>{e.preventDefault();document.getElementById(h.id)?.scrollIntoView({behavior:'smooth',block:'start'});});nav.appendChild(a);});
    const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){nav.querySelectorAll('.sidebar-item').forEach(a=>a.classList.remove('active'));const act=nav.querySelector('[href="#'+e.target.id+'"]');if(act)act.classList.add('active');}});},{rootMargin:'-10% 0px -80% 0px'});
    hs.forEach(h=>obs.observe(h));
  })();
</script>
