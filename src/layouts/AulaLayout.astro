---
import Base from './Base.astro'
const { aula } = Astro.props
const {
  numero, titulo, tituloEm, subtitulo,
  dataA, dataB, duracao, topicos = [], disciplina = 'PI I'
} = aula
---
<Base title={`${titulo} ${tituloEm} · ETE Cícero Dias`} description={subtitulo}>

  <!-- HERO DA AULA -->
  <section class="hero-aula">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="hero-aula-inner">
      <div class="hero-aula-badge">
        <span class="bdot"></span>
        Aula {numero} · {disciplina} · {dataA}
      </div>
      <h1 class="hero-aula-title">{titulo} <em>{tituloEm}</em></h1>
      <p class="hero-aula-sub">{subtitulo}</p>
      <div class="hero-aula-meta">
        <span class="ham-tag">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
          {duracao}
        </span>
        {dataB && dataB !== dataA && (
          <span class="ham-tag">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Turma B: {dataB}
          </span>
        )}
        {topicos.map((t: string) => (
          <span class="ham-tag">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTEÚDO -->
  <div class="aula-content-wrap">
    <div class="aula-prose">
      <slot />
    </div>
  </div>

</Base>

<style>
  .aula-content-wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 4rem 2rem 8rem;
  }

  /* ── PROSE — estilos do conteúdo MDX ───────── */
  .aula-prose :global(h2) {
    font-family: var(--font-h);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 300;
    letter-spacing: -.03em;
    line-height: 1.1;
    margin: 3.5rem 0 1rem;
    padding-bottom: .6rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .aula-prose :global(h2 em) { font-style: italic; color: var(--primary); }

  .aula-prose :global(h3) {
    font-family: var(--font-h);
    font-size: 1.4rem;
    font-weight: 400;
    margin: 2.5rem 0 .7rem;
    color: var(--text);
  }

  .aula-prose :global(h4) {
    font-size: .8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--primary);
    margin: 1.8rem 0 .5rem;
  }

  .aula-prose :global(p) {
    font-size: .97rem;
    color: var(--text-2);
    line-height: 1.85;
    margin-bottom: 1.1rem;
  }

  .aula-prose :global(strong) { font-weight: 700; color: var(--text); }
  .aula-prose :global(em) { font-style: italic; color: var(--primary); }

  .aula-prose :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .aula-prose :global(ul), .aula-prose :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }
  .aula-prose :global(li) {
    font-size: .93rem;
    color: var(--text-2);
    line-height: 1.65;
  }
  .aula-prose :global(li code) {
    font-family: var(--font-mono);
    font-size: .82em;
    background: var(--code-bg);
    color: var(--code-text);
    padding: .12em .4em;
    border-radius: 4px;
  }

  .aula-prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.4rem;
    border-left: 3px solid var(--primary);
    background: var(--glass);
    border-radius: 0 12px 12px 0;
    font-size: .9rem;
    color: var(--text-2);
    line-height: 1.75;
  }
  .aula-prose :global(blockquote strong) { color: var(--primary); }
  .aula-prose :global(blockquote p) { margin: 0; }

  .aula-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .aula-prose :global(pre) {
    background: #0a0814;
    border-radius: 14px;
    padding: 1.4rem 1.6rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid rgba(124,74,224,.25);
  }
  .aula-prose :global(pre code) {
    font-family: var(--font-mono);
    font-size: .82rem;
    color: #e4e0f7;
    line-height: 1.75;
    background: none;
    padding: 0;
  }
  .aula-prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: .82em;
    background: var(--code-bg);
    color: var(--code-text);
    padding: .15em .4em;
    border-radius: 5px;
  }

  .aula-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: .85rem;
    margin: 1.5rem 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .aula-prose :global(thead) { background: var(--glass); }
  .aula-prose :global(th) {
    padding: .7rem 1rem;
    text-align: left;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--primary);
    border-bottom: 1px solid var(--border);
  }
  .aula-prose :global(td) {
    padding: .65rem 1rem;
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .aula-prose :global(tr:last-child td) { border-bottom: none; }
  .aula-prose :global(td code), .aula-prose :global(th code) {
    font-family: var(--font-mono);
    font-size: .8em;
    background: var(--code-bg);
    color: var(--code-text);
    padding: .1em .35em;
    border-radius: 4px;
  }

  @media(max-width: 600px) {
    .aula-content-wrap { padding: 3rem 1.25rem 6rem; }
  }
</style>
